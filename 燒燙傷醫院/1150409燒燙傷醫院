    appleQ: '衛生福利部屏東醫院屏東縣屏東市自由路270號'
  }
];

function switchTab(mode) {
  document.querySelectorAll('.tab-btn').forEach((b, i) =>
    b.classList.toggle('active', (mode === 'gps' && i === 0) || (mode === 'manual' && i === 1)));
  document.getElementById('panel-gps').classList.toggle('active', mode === 'gps');
  document.getElementById('panel-manual').classList.toggle('active', mode === 'manual');
  if (mode === 'manual' && !document.getElementById('township-select').value) {
    document.getElementById('hospitals-section').style.display = 'none';
  }
}

function onTownshipChange() {
  const v = document.getElementById('township-select').value;
  if (v) showHospitals(v);
  else document.getElementById('hospitals-section').style.display = 'none';
}

function showHospitals(label) {
  document.getElementById('location-tag').textContent = '📍 ' + label;
  const list = document.getElementById('hospital-list');
  list.innerHTML = '';
  hospitals.forEach((h, i) => {
    const bedsText = (h.beds === 0 && h.icu === 0)
      ? '<span class="bed-pill">請電話確認床位</span>'
      : `<span class="bed-pill"><b>${h.beds}</b>床 燒燙傷</span><span class="bed-pill"><b>${h.icu}</b>床 加護</span>`;
    const extRow = h.ext ? `<div class="h-meta"><strong>分機：</strong>${h.ext}</div>` : '';
    const card = document.createElement('div');
    card.className = 'h-card' + (h.top ? ' top' : '');
    card.style.animationDelay = (i * 0.07) + 's';
    card.innerHTML = `
      <div class="h-top-row">
        <div class="h-num">${h.rank}</div>
        <div class="h-main">
          ${h.badge ? `<div class="h-badge">${h.badge}</div>` : ''}
          <div class="h-name">${h.name}</div>
          <div class="h-meta"><strong>電話：</strong>${h.phoneDisplay}</div>
          ${extRow}
          <div class="h-meta"><strong>地址：</strong>${h.address}</div>
        </div>
      </div>
      <div class="beds-row">${bedsText}</div>
      <div class="h-actions">
        <a class="action-btn call" href="tel:${h.phone}">
          <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.01 2.2 2 2 0 012 .02h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91A16 16 0 0016 16.94l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          撥打電話
        </a>
        <a class="action-btn map" href="https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(h.address)}&travelmode=driving" target="_blank" rel="noopener">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 11l19-9-9 19-2-8-8-2z"/></svg>
          Google 導航
        </a>
        <a class="action-btn map" href="https://maps.apple.com/?daddr=${encodeURIComponent(h.address)}&dirflg=d" target="_blank" rel="noopener">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
