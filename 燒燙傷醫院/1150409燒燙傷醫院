function getLocation() {
  const statusEl = document.getElementById('gps-status');
  const msgEl = document.getElementById('gps-msg');
  const spinner = document.getElementById('gps-spinner');

  statusEl.className = 'gps-status';
  spinner.style.display = 'inline-block';
  msgEl.textContent = '定位中，請稍候…';

  if (!navigator.geolocation) {
    spinner.style.display = 'none';
    statusEl.className = 'gps-status err';
    msgEl.textContent = '此瀏覽器不支援 GPS，請改用手動選擇。';
    return;
  }

  navigator.geolocation.getCurrentPosition(
    pos => {
      spinner.style.display = 'none';
      const lat = pos.coords.latitude.toFixed(4);
      const lng = pos.coords.longitude.toFixed(4);
      const acc = Math.round(pos.coords.accuracy);
      statusEl.className = 'gps-status ok';
      msgEl.textContent = `定位成功 — 緯度 ${lat}，經度 ${lng}（精確度 ±${acc} 公尺）`;
      showHospitals('GPS 自動定位');
    },
    err => {
      spinner.style.display = 'none';
      statusEl.className = 'gps-status err';
      const msgs = {
        1: '請允許瀏覽器存取位置權限，再重試。',
        2: '無法取得位置訊號，請確認 GPS 已開啟。',
        3: '定位逾時，請重試或改用手動選擇。'
      };
      msgEl.textContent = msgs[err.code] || '定位失敗，請改用手動選擇鄉鎮。';
    },
    { timeout: 12000, enableHighAccuracy: true }
  );
}
